local ESPOn=false
local NamesOn=false
local ESP={}
local Names={}

local function AddESP(plr)
	if plr==LP or not plr.Character then return end

	if ESP[plr] then
		ESP[plr]:Destroy()
	end

	local h=Instance.new("Highlight")
	h.Name="PepsiESP"
	h.FillTransparency=.65
	h.OutlineTransparency=0
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent=plr.Character
	ESP[plr]=h
end

local function RemoveESP(plr)
	if ESP[plr] then
		ESP[plr]:Destroy()
		ESP[plr]=nil
	end
end

local function AddName(plr)
	if plr==LP or not plr.Character then return end

	if Names[plr] then
		Names[plr]:Destroy()
	end

	local head=plr.Character:FindFirstChild("Head")
	if not head then return end

	local b=Instance.new("BillboardGui")
	b.Name="PepsiName"
	b.Size=UDim2.fromOffset(150,30)
	b.StudsOffset=Vector3.new(0,2.5,0)
	b.AlwaysOnTop=true
	b.Parent=head

	local t=Instance.new("TextLabel")
	t.Size=UDim2.fromScale(1,1)
	t.BackgroundTransparency=1
	t.Text=plr.DisplayName
	t.TextColor3=Color3.new(1,1,1)
	t.TextStrokeTransparency=.3
	t.TextSize=13
	t.Font=Enum.Font.GothamBold
	t.Parent=b

	Names[plr]=b
end

local function RemoveName(plr)
	if Names[plr] then
		Names[plr]:Destroy()
		Names[plr]=nil
	end
end

