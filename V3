local function SaveCollision()
	CollisionCache={}

	local c=LP.Character
	if not c then return end

	for _,p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then
			CollisionCache[p]=p.CanCollide
		end
	end
end

local function RestoreCollision()
	for p,v in pairs(CollisionCache) do
		if p and p.Parent then
			p.CanCollide=v
		end
	end

	CollisionCache={}
end

local function StartNoClip()
	if NoClipConn then
		NoClipConn:Disconnect()
	end

	SaveCollision()

	NoClipConn=RS.Stepped:Connect(function()
		local c=LP.Character
		if not c then return end

		for _,p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") then
				if CollisionCache[p]==nil then
					CollisionCache[p]=p.CanCollide
				end
				p.CanCollide=false
			end
		end
	end)
end

local function StopNoClip()
	if NoClipConn then
		NoClipConn:Disconnect()
		NoClipConn=nil
	end

	RestoreCollision()
end

Toggle(Player,"NoClip",220,function(v)
