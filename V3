local NPCESPOn=false
local NPCESP={}

local function IsNPC(m)
	return m:IsA("Model")
		and m:FindFirstChildOfClass("Humanoid")
		and not P:GetPlayerFromCharacter(m)
end

local function AddNPC(m)
	if not NPCESPOn or not IsNPC(m) then return end
	if NPCESP[m] then return end

	local h=Instance.new("Highlight")
	h.Name="PepsiNPCESP"
	h.FillTransparency=.65
	h.OutlineTransparency=0
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent=m
	NPCESP[m]=h
end

local function ClearNPC()
	for m,h in pairs(NPCESP) do
		if h then h:Destroy() end
		NPCESP[m]=nil
	end
end

Toggle(Visual,"ESP NPC / Dummy",118,function(v)
	NPCESPOn=v
	ClearNPC()

	if v then
		for _,m in ipairs(workspace:GetDescendants()) do
			AddNPC(m)
		end
	end
end)

workspace.DescendantAdded:Connect(function(m)
	if NPCESPOn then
		task.defer(function()
			if m and m.Parent then
				AddNPC(m)
			end
		end)
	end
end)

workspace.DescendantRemoving:Connect(function(m)
	if NPCESP[m] then
		NPCESP[m]=nil
	end
end)

local function Show(n)
	for k,p in pairs(Pages) do
		p.Visible=(k==n)
	end

	for k,b in pairs(Buttons) do
		b.BackgroundColor3=k==n and Color3.fromRGB(40,40,50) or Color3.fromRGB(25,25,31)
		b.TextColor3=k==n and Color3.new(1,1,1) or Color3.fromRGB(180,180,190)
		Indicators[k].Visible=(k==n)
	end
end

for n,b in pairs(Buttons) do
	b.Activated:Connect(function()
		Show(n)
	end)
end

