local function Toggle(p,t,y,cb)
	local c=Card(p,y,48)

	local l=Instance.new("TextLabel")
	l.Size=UDim2.new(1,-75,1,0)
	l.Position=UDim2.fromOffset(14,0)
	l.BackgroundTransparency=1
	l.Text=t
	l.TextColor3=Color3.fromRGB(235,235,240)
	l.TextSize=13
	l.Font=Enum.Font.Gotham
	l.TextXAlignment=Enum.TextXAlignment.Left
	l.Parent=c

	local b=Instance.new("TextButton")
	b.Size=UDim2.fromOffset(48,25)
	b.Position=UDim2.new(1,-60,.5,-12)
	b.Text="OFF"
	b.TextSize=10
	b.TextColor3=Color3.new(1,1,1)
	b.BackgroundColor3=Color3.fromRGB(65,65,75)
	b.Parent=c
	Instance.new("UICorner",b).CornerRadius=UDim.new(1,0)

	local on=false

	local function Set(v)
		on=v
		b.Text=v and "ON" or "OFF"
		b.BackgroundColor3=v and Color3.fromRGB(70,170,100) or Color3.fromRGB(65,65,75)
		if cb then cb(v) end
	end

	b.Activated:Connect(function()
		Set(not on)
	end)

	return Set
end

